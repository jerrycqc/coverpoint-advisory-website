---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo variant="light" />
      <p>Commercial insurance and risk advisory for mid-market B2B companies.</p>
    </div>
    <nav class="footer__nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer__meta">
      <p>{site.email}</p>
      <p>&copy; {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--charcoal-900); color: var(--bg-light); padding: 56px 0 40px; }
  .footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px; }
  .footer__brand { max-width: 320px; display: flex; flex-direction: column; gap: 14px; }
  .footer__brand p { font-size: 14px; color: rgba(244, 242, 239, 0.65); line-height: 1.6; }
  .footer__nav { display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: rgba(244, 242, 239, 0.8); }
  .footer__nav a:hover { color: var(--teal-light); }
  .footer__meta { font-size: 13px; color: rgba(244, 242, 239, 0.55); display: flex; flex-direction: column; gap: 8px; text-align: right; }
  @media (max-width: 700px) { .footer__meta { text-align: left; } }
</style>
